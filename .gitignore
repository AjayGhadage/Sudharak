# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Dependencies ──────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── Environment files (NEVER commit real secrets) ─────────────
.env
.env.local
.env.production
.env.development
*.env.template
*.env.production.template
.env.production.template

# ── Database ──────────────────────────────────────────────────
server/prisma/dev.db
server/prisma/*.db-journal
server/prisma/migrations/

# ── Uploads (store in S3, not git) ────────────────────────────
server/uploads/*
!server/uploads/.gitkeep

# ── AWS key files ─────────────────────────────────────────────
*.pem
*.key
prod.env
remote-env.txt
sudharak-aws-info.txt
setup-https.sh

# ── Editor ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Python ────────────────────────────────────────────────────
ml-services/venv/
ml-services/__pycache__/
ml-services/**/*.pyc

.neon
